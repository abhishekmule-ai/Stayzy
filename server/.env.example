# Stayzy Server Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_in_production

# MySQL Database Configuration (Local or Cloud)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=stayzy_db
DB_SSL=false

# Or Alternatively, Cloud Database Connection String (e.g. TiDB Cloud, Aiven, Railway):
# DATABASE_URL=mysql://user:password@gateway01.region.prod.aws.tidbcloud.com:4000/stayzy_db?ssl=true

